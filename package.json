{
	"name": "universal-remote-card",
	"version": "4.12.0",
	"description": "Universal Remote Card",
	"main": "./dist/universal-remote-card.min.js",
	"type": "module",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "npx rspack && gzip -fk dist/universal-remote-card.min.js",
		"prelint": "tsc --noemit",
		"lint": "eslint --fix --config ./eslint.config.js",
		"build-css": "tcm src",
		"setup": "git config --add core.hooksPath githooks && chmod +x githooks/pre-commit && npm i"
	},
	"lint-staged": {
		"*": "prettier -w"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nerwyn/universal-remote-card.git"
	},
	"keywords": [
		"androidtv",
		"android",
		"googletv",
		"google",
		"tvcard",
		"remote",
		"tv",
		"television"
	],
	"author": "Nerwyn",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/Nerwyn/universal-remote-card/issues"
	},
	"homepage": "https://github.com/Nerwyn/universal-remote-card#readme",
	"dependencies": {
		"ha-nunjucks": "^1.7.8",
		"js-yaml": "^5.4.2",
		"lit": "^3.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rspack/cli": "^2.2.4",
		"@rspack/core": "^2.2.4",
		"@types/js-yaml": "^4.0.9",
		"@typescript-eslint/eslint-plugin": "latest",
		"@typescript-eslint/parser": "latest",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"home-assistant-js-websocket": "^9.6.0",
		"lint-staged": "^17.5.1",
		"lit-css-loader": "^4.0.1",
		"minify-html-literals-loader": "^1.1.1",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0"
	}
}
